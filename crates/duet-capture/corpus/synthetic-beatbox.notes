# notefmt v1: positions are bar.beat.tick, lengths are quarter notes
# Hand-checked: two bars of 4/4 at 120 bpm, eighth notes, kick hat snare hat kick hat snare hat
# in each, as scripts/capture-fixtures.sh generates them. Keys are the gm lanes': C2 36 kick,
# D2 38 snare, F#2 42 hh (closed hi-hat).
tpq 480
tempo 120
time 4/4
end 3.1.0

[track "drums" ch10]
