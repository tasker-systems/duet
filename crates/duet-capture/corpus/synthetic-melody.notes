# notefmt v1: positions are bar.beat.tick, lengths are quarter notes
# Hand-checked: eight quarter notes at 120 bpm, C4 E4 G4 C5 G4 E4 C4 C4, as
# scripts/capture-fixtures.sh generates them (each sounds 0.9 of a quarter).
tpq 480
tempo 120
time 4/4
key C major
end 3.1.0

[track "melody" ch1]
1.1.0     C4    0.9    100
1.2.0     E4    0.9    100
1.3.0     G4    0.9    100
1.4.0     C5    0.9    100
2.1.0     G4    0.9    100
2.2.0     E4    0.9    100
2.3.0     C4    0.9    100
2.4.0     C4    0.9    100
