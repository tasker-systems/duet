{
  "$defs": {
    "At": {
      "description": "A UTC time to the millisecond, such as 2026-11-17T15:04:05.123Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "Closes": {
      "additionalProperties": false,
      "description": "The summary of the segment an index line closes. The segment's file stays the truth: `journal\ncheck` compares the two and states any difference.",
      "properties": {
        "entries": {
          "description": "How many entries it holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "last": {
          "$ref": "#/$defs/Id",
          "description": "Its last entry's id."
        },
        "parts": {
          "description": "The parts its events concern, as `<song>/<part>`, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "segment": {
          "$ref": "#/$defs/SegmentStamp",
          "description": "Its stamp."
        },
        "songs": {
          "description": "The songs its events concern, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "takes": {
          "description": "The takes its events concern, by name and digest.",
          "items": {
            "$ref": "#/$defs/TakeRef"
          },
          "type": "array"
        },
        "to": {
          "$ref": "#/$defs/At",
          "description": "When its last entry was written."
        }
      },
      "required": [
        "segment",
        "to",
        "entries",
        "last"
      ],
      "type": "object"
    },
    "Id": {
      "description": "A UUIDv7, lowercase and hyphenated.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "IndexHead": {
      "additionalProperties": false,
      "description": "`journal-index` 1.0's first line holds the head: the project's name, and the journal's own\nid, made when it was started.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id",
          "description": "The journal's id."
        },
        "project": {
          "description": "The name of the project whose journal this is.",
          "type": "string"
        }
      },
      "required": [
        "project",
        "id"
      ],
      "type": "object"
    },
    "IndexLine": {
      "additionalProperties": false,
      "description": "One index line: it opens a segment, and, after the first, closes the one before it, in one\nwrite (bus design decision 21).",
      "properties": {
        "closes": {
          "$ref": "#/$defs/Closes",
          "description": "Absent on the first line."
        },
        "opens": {
          "$ref": "#/$defs/Opens"
        }
      },
      "required": [
        "opens"
      ],
      "type": "object"
    },
    "Opens": {
      "additionalProperties": false,
      "description": "The segment an index line opens.",
      "properties": {
        "from": {
          "$ref": "#/$defs/At",
          "description": "The moment it was opened."
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "Its id, as its head names it."
        },
        "segment": {
          "$ref": "#/$defs/SegmentStamp",
          "description": "Its stamp, which names its file."
        }
      },
      "required": [
        "segment",
        "id",
        "from"
      ],
      "type": "object"
    },
    "Record": {
      "$ref": "#/$defs/IndexLine"
    },
    "SegmentStamp": {
      "description": "A segment's first moment, UTC to the millisecond in ISO 8601 basic form, such as 20261117T150405123Z. Its file is journal.<stamp>.duet.jsonl.",
      "pattern": "^[0-9]{8}T[0-9]{9}Z$",
      "type": "string"
    },
    "TakeDigest": {
      "description": "The SHA-256 of a take's decoded samples: the bytes `duet-take-1`, the rate as a little-endian u32, the channel count as a little-endian u16, then every sample, interleaved, as the little-endian bits of its f32.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "TakeRef": {
      "additionalProperties": false,
      "description": "A take as the index names it: its name and its digest, never a path.",
      "properties": {
        "digest": {
          "$ref": "#/$defs/TakeDigest"
        },
        "take": {
          "type": "string"
        }
      },
      "required": [
        "take",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/tasker-systems/duet/main/crates/duet-schemas/schemas/journal-index/1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The first line of a .duet.jsonl stream of kind journal-index, at schema version 1.0.",
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/tasker-systems/duet/main/crates/duet-schemas/schemas/journal-index/1.0.json"
    },
    "duet": {
      "$ref": "https://raw.githubusercontent.com/tasker-systems/duet/main/crates/duet-schemas/schemas/envelope/1.0.json",
      "properties": {
        "kind": {
          "const": "journal-index"
        },
        "version": {
          "const": "1.0"
        }
      }
    },
    "head": {
      "$ref": "#/$defs/IndexHead"
    }
  },
  "required": [
    "duet",
    "head"
  ],
  "title": "duet journal-index 1.0",
  "type": "object"
}
